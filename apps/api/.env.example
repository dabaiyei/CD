APP_ENV=development
# Relative SQLite paths are resolved from the repository root, independent of process CWD.
DATABASE_URL=sqlite+aiosqlite:///./cineforge.db
JWT_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_SECRET=replace-with-a-different-random-secret
CORS_ORIGINS=http://localhost:5173
SEED_DEMO_DATA=true
SKILLS_ROOT=./skills
UPLOADS_ROOT=./uploads
WORKER_CONCURRENCY=8
AGENT_CHAT_TASK_TIMEOUT_SECONDS=300
