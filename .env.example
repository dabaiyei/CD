## Source root relative to docker-compose.yml. Use .. when a NAS stack manager
## stores docker-compose.yml in a generated child directory such as CD/CD.
CINEFORGE_SOURCE_ROOT=.

## Explicit Compose subnet. Change it if this range overlaps a NAS, LAN or VPN route.
CINEFORGE_NETWORK_SUBNET=10.253.0.0/24

POSTGRES_DB=cineforge
POSTGRES_USER=cineforge
POSTGRES_PASSWORD=change-this-database-password
JWT_SECRET=change-this-to-a-long-random-jwt-secret
CREDENTIAL_ENCRYPTION_SECRET=change-this-to-a-long-random-encryption-secret
AGENT_RUNTIME_INTERNAL_TOKEN=change-this-to-a-long-random-internal-token
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT=30
LOGIN_RATE_WINDOW_SECONDS=300
S3_BUCKET=cineforge
S3_ACCESS_KEY_ID=cineforge
S3_SECRET_ACCESS_KEY=change-this-object-storage-secret
MEDIA_SIGNING_SECRET=change-this-media-signing-secret
SEED_DEMO_DATA=true
WEB_PORT=8080
WORKER_CONCURRENCY=8
AGENT_CHAT_TASK_TIMEOUT_SECONDS=300
